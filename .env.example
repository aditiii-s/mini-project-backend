# ---------------------------------------------------------------------------
# Supabase (managed PostgreSQL)
# Project Settings -> Database -> Connection string -> URI
#
# Session pooler (port 5432) - recommended for this long-running FastAPI app:
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Transaction pooler (port 6543) also works - the app detects it and disables
# client-side pooling and prepared statements automatically:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# If your password contains @ : / ? # or %, URL-encode it (e.g. @ becomes %40).
# ---------------------------------------------------------------------------

# Set to false on serverless hosts (Vercel) so the schema/seed pass does not
# run on every cold start. Create the schema once by running locally with it on.
RUN_DB_INIT=true

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS (comma separated) - add your deployed frontend URL in production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: allow Vercel preview deployments too
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
